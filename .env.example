# Redis-Zugriff (Upstash, z. B. über die Vercel-Marketplace-Integration
# automatisch gesetzt, oder manuell aus einem eigenen Upstash-Projekt).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin-Login: NICHT das Klartext-Passwort speichern.
# Erzeugen mit: npm run admin:hash-password
ADMIN_PASSWORD_HASH=
